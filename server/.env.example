AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! Talk to me and watch the event timeline light up.

# Select the STT vendor for the agent's transcription leg. Default is the
# keyless, Agora-managed `deepgram` vendor, so this recipe runs zero-key out of
# the box. Set STT_VENDOR to any value below and provide that vendor's
# credentials to swap.
# STT_VENDOR=deepgram
# STT_MODEL=nova-3        # optional model override (vendors with a model field)
# STT_LANGUAGE=en         # optional language hint (documented per vendor)

# --- BYO STT vendors (set STT_VENDOR + the listed env vars to use one) ---

# STT_VENDOR=assemblyai
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# STT_VENDOR=speechmatics
# SPEECHMATICS_API_KEY=your_speechmatics_api_key

# STT_VENDOR=openai
# OPENAI_STT_API_KEY=your_openai_api_key

# STT_VENDOR=microsoft
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus

# STT_VENDOR=google
# GOOGLE_APPLICATION_CREDENTIALS_JSON=your_service_account_json
# GOOGLE_PROJECT_ID=your_gcp_project_id
# GOOGLE_LOCATION=us-central1

# Gemini Transcription (preview; SDK routes the session automatically)
# STT_VENDOR=gemini
# GEMINI_STT_API_KEY=your_gemini_api_key

# STT_VENDOR=amazon
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# STT_VENDOR=sarvam
# SARVAM_API_KEY=your_sarvam_api_key
